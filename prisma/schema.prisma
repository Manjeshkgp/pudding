generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  PRIMARY_PARENT
  CO_PARENT
  ADMIN
}

enum CoParentPermissionLevel {
  EQUAL
  LIMITED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WalletBucket {
  SPEND
  SAVE
  GIVE // Historical ledger entries only.
  FAMILY_BUDGET
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerEntryType {
  BUDGET_ADD
  BUDGET_ADJUST
  INSTANT_TRANSFER
  BUCKET_TRANSFER
  ALLOWANCE
  CHORE_REWARD
  CHORE_STREAK_BONUS
  GOAL_DEPOSIT
  GOAL_WITHDRAWAL
  GOAL_MATCH
  SAVINGS_INTEREST
  SPEND_OPTION_A_PAYPAL
  SPEND_OPTION_B_ORDER
  DONATION
  LESSON_REWARD
  REVERSAL
  DISPUTE_ADJUSTMENT
}

enum LedgerStatus {
  COMPLETED
  PENDING_CLAIM
  REVERSED
  FAILED
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum AllowanceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM_DAY
}

enum AllowanceStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum ChoreRecurrence {
  ONCE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum SpendingOptionType {
  OPTION_A_PAYPAL_EMAIL
  OPTION_B_PRODUCT_ORDER
}

enum SpendingRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COUNTER_OFFERED
  PAID_COMPLETED
  PAID_PENDING_CLAIM
  PAYMENT_FAILED
  REVERSED
  CANCELLED
}

enum DonationStatus {
  PENDING_APPROVAL
  APPROVED_COMPLETED
  PAID_PENDING_CLAIM
  REJECTED
  FAILED
}

enum LessonTopic {
  SAVING
  NEEDS_VS_WANTS
  BUDGETING
  INTEREST
  SCAMS
}

enum AgeGroup {
  AGE_6_9
  AGE_10_13
  AGE_14_17
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

enum PushPlatform {
  WEB_VAPID
  MOBILE_FCM
  MOBILE_APNS
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUNDED
  REJECTED
}

enum WebhookProcessStatus {
  PROCESSED
  FAILED
  IGNORED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  MFA_CHALLENGE
  PASSWORD_RESET
}

// ============================================================================
// CORE MODELS
// ============================================================================

model Family {
  id                        String   @id @default(cuid())
  name                      String
  familyCode                String   @unique
  unallocatedBudget         Decimal  @default(0.00) @db.Decimal(12, 2)
  spendingLimit             Decimal  @default(0.00) @db.Decimal(12, 2)
  spentTotal                Decimal  @default(0.00) @db.Decimal(12, 2)
  reservedTotal             Decimal  @default(0.00) @db.Decimal(12, 2)
  autoTopUpAmount           Decimal? @db.Decimal(12, 2)
  autoTopUpThreshold        Decimal? @db.Decimal(12, 2)
  autoTopUpSchedule         String?
  siblingLeaderboardEnabled Boolean  @default(false)
  currency                  String   @default("USD")
  isFrozen                  Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  parents          User[]
  children         Child[]
  coParentInvites  CoParentInvite[]
  ledgerEntries    LedgerEntry[]
  chores           Chore[]
  spendingRequests SpendingRequest[]
  donations        Donation[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  disputes         Dispute[]
  auditLogs        AuditLog[]
  topUps           FamilyTopUp[]
  purchases        Purchase[]

  @@index([familyCode])
}

model User {
  id                            String                  @id @default(cuid())
  familyId                      String?
  email                         String                  @unique
  phone                         String?                 @unique
  passwordHash                  String
  pinHash                       String?
  failedPinAttempts             Int                     @default(0)
  pinLockedUntil                DateTime?
  name                          String
  firstName                     String?
  lastName                      String?
  avatar                        String                  @default("avatar-1")
  role                          UserRole                @default(PRIMARY_PARENT)
  permissionLevel               CoParentPermissionLevel @default(EQUAL)
  permissions                   Json?
  isEmailVerified               Boolean                 @default(false)
  isKycSimulatedVerified        Boolean                 @default(false)
  paypalPayerId                 String?
  paypalVerifiedEmail           String?
  paypalIsVerified              Boolean                 @default(false)
  paypalLinkedAt                DateTime?
  paypalCustomerId              String?
  paypalVaultId                 String?
  paypalSetupTokenId            String?
  onboardingChildrenConfirmedAt DateTime?
  onboardingCompletedAt         DateTime?
  mfaEnabled                    Boolean                 @default(false)
  mfaSecret                     String?
  isFrozen                      Boolean                 @default(false)
  lastLoginAt                   DateTime?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  family                 Family?                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  consentsGranted        ConsentRecord[]
  sentInvites            CoParentInvite[]        @relation("InvitedByParent")
  choreReviews           ChoreSubmission[]       @relation("ReviewedByParent")
  spendingReviews        SpendingRequest[]       @relation("SpendingReviewedByParent")
  notifications          Notification[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  securityQuestions      UserSecurityQuestion[]
  supportTickets         SupportTicket[]
  disputes               Dispute[]
  verificationTokens     VerificationToken[]
  auditLogs              AuditLog[]              @relation("ActorUser")

  @@index([familyId])
  @@index([email])
  @@index([paypalSetupTokenId])
  @@index([paypalPayerId])
}

model CoParentInvite {
  id              String                  @id @default(cuid())
  familyId        String
  invitedByUserId String
  email           String
  name            String
  firstName       String?
  lastName        String?
  permissionLevel CoParentPermissionLevel @default(EQUAL)
  permissions     Json?
  inviteToken     String                  @unique
  status          InviteStatus            @default(PENDING)
  expiresAt       DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedByParent", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([email])
  @@index([inviteToken])
}

model Child {
  id                   String    @id @default(cuid())
  familyId             String
  name                 String
  firstName            String?
  lastName             String?
  username             String    @unique
  dateOfBirth          DateTime? @db.Date
  age                  Int
  avatar               String    @default("default-kid")
  theme                String    @default("ocean")
  pinHash              String?
  failedPinAttempts    Int       @default(0)
  pinLockedUntil       DateTime?
  isFrozen             Boolean   @default(false)
  quietHoursStart      String?   @default("21:00")
  quietHoursEnd        String?   @default("07:00")
  streakCount          Int       @default(0)
  lastChoreCompletedAt DateTime?
  level                Int       @default(1)
  xp                   Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  family            Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wallet            Wallet?
  consentRecords    ConsentRecord[]
  allowanceRules    AllowanceRule[]
  choreSubmissions  ChoreSubmission[]
  choreEvidence     ChoreEvidence[]
  savingsGoals      SavingsGoal[]
  spendingRequests  SpendingRequest[]
  purchases         Purchase[]
  spendingRule      SpendingRule?
  donations         Donation[]
  lessonProgress    LessonProgress[]
  earnedBadges      ChildBadge[]
  ledgerEntries     LedgerEntry[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]         @relation("ActorChild")

  @@index([familyId])
}

model Wallet {
  id                      String   @id @default(cuid())
  childId                 String   @unique
  spendBalance            Decimal  @default(0.00) @db.Decimal(12, 2)
  saveBalance             Decimal  @default(0.00) @db.Decimal(12, 2)
  lockedPendingBalance    Decimal  @default(0.00) @db.Decimal(12, 2)
  purchaseReservedBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  defaultSplitSpend       Int      @default(70)
  defaultSplitSave        Int      @default(30)
  isFrozen                Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id              String          @id @default(cuid())
  familyId        String
  childId         String?
  walletBucket    WalletBucket
  amount          Decimal         @db.Decimal(12, 2)
  direction       LedgerDirection
  type            LedgerEntryType
  status          LedgerStatus    @default(COMPLETED)
  idempotencyKey  String          @unique
  referenceId     String?
  paypalOrderId   String?
  paypalCaptureId String?
  actorUserId     String?
  actorChildId    String?
  description     String
  metadata        Json?
  createdAt       DateTime        @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child  Child? @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([childId, createdAt])
  @@index([paypalOrderId])
  @@index([paypalCaptureId])
  @@index([type, status])
}

model ConsentRecord {
  id             String        @id @default(cuid())
  parentId       String
  childId        String
  consentVersion String        @default("1.0")
  consentText    String
  ipAddress      String?
  userAgent      String?
  status         ConsentStatus @default(GRANTED)
  grantedAt      DateTime      @default(now())
  withdrawnAt    DateTime?

  parent User  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child  Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([parentId])
}

// ============================================================================
// ALLOWANCES, CHORES & SAVINGS GOALS
// ============================================================================

model AllowanceRule {
  id                   String             @id @default(cuid())
  creationKey          String?            @unique
  childId              String
  amount               Decimal            @db.Decimal(12, 2)
  frequency            AllowanceFrequency @default(WEEKLY)
  dayOfWeek            Int? // 0 (Sun) - 6 (Sat)
  dayOfMonth           Int? // 1 - 31
  requireAllChores     Boolean            @default(false)
  reduceByMissedChores Boolean            @default(false)
  status               AllowanceStatus    @default(ACTIVE)
  nextRunAt            DateTime
  lastRunAt            DateTime?
  anchorAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([status, nextRunAt])
}

model Chore {
  id              String          @id @default(cuid())
  familyId        String?
  title           String
  description     String?
  rewardAmount    Decimal         @db.Decimal(12, 2)
  dueDate         DateTime?
  recurrence      ChoreRecurrence @default(ONCE)
  assigneeIds     String[]
  ageGroupTag     String?
  isTemplate      Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  family      Family?           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  submissions ChoreSubmission[]
  evidence    ChoreEvidence[]

  @@index([familyId])
  @@index([isTemplate])
}

model ChoreSubmission {
  id                String           @id @default(cuid())
  choreId           String
  childId           String
  proofPhotoUrl     String?
  beforeEvidenceId  String?          @unique
  afterEvidenceId   String?          @unique
  aiStatus          String           @default("NOT_REVIEWED")
  approvalSource    String?
  aiVerdict         String?
  aiReason          String?
  aiReviewedAt      DateTime?
  aiReviewStartedAt DateTime?
  childNote         String?
  status            SubmissionStatus @default(PENDING)
  parentComment     String?
  reviewedByUserId  String?
  rewardAmountPaid  Decimal?         @db.Decimal(12, 2)
  submittedAt       DateTime         @default(now())
  reviewedAt        DateTime?

  chore          Chore          @relation(fields: [choreId], references: [id], onDelete: Cascade)
  child          Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation("ReviewedByParent", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  beforeEvidence ChoreEvidence? @relation("BeforeEvidence", fields: [beforeEvidenceId], references: [id], onDelete: SetNull)
  afterEvidence  ChoreEvidence? @relation("AfterEvidence", fields: [afterEvidenceId], references: [id], onDelete: SetNull)

  @@index([choreId])
  @@index([childId, status])
}

// Small private demo photos; served only after family/child authorization.
model ChoreEvidence {
  id               String           @id @default(cuid())
  choreId          String
  childId          String
  stage            String
  mimeType         String
  image            Bytes
  sha256           String
  createdAt        DateTime         @default(now())
  chore            Chore            @relation(fields: [choreId], references: [id], onDelete: Cascade)
  child            Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  beforeSubmission ChoreSubmission? @relation("BeforeEvidence")
  afterSubmission  ChoreSubmission? @relation("AfterEvidence")

  @@index([choreId, childId, createdAt])
}

model SavingsGoal {
  id                     String     @id @default(cuid())
  childId                String
  name                   String
  targetAmount           Decimal    @db.Decimal(12, 2)
  currentAmount          Decimal    @default(0.00) @db.Decimal(12, 2)
  imageUrl               String?
  deadline               DateTime?
  isLocked               Boolean    @default(false)
  unlockApprovedByParent Boolean    @default(false)
  matchPercentage        Decimal    @default(0.00) @db.Decimal(5, 2)
  matchMaxAmount         Decimal?   @db.Decimal(12, 2)
  matchedTotalSoFar      Decimal    @default(0.00) @db.Decimal(12, 2)
  interestRateApr        Decimal    @default(0.00) @db.Decimal(5, 2)
  lastInterestAppliedAt  DateTime?
  status                 GoalStatus @default(ACTIVE)
  completedAt            DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, status])
}

// ============================================================================
// SPENDING REQUESTS, RULES & GIVING
// ============================================================================

model SpendingRequest {
  id                   String                @id @default(cuid())
  familyId             String
  childId              String
  optionType           SpendingOptionType
  amount               Decimal               @db.Decimal(12, 2)
  category             String
  merchantName         String?
  purpose              String
  recipientPaypalEmail String?
  productName          String?
  productUrl           String?
  productPhotoUrl      String?
  status               SpendingRequestStatus @default(PENDING_APPROVAL)
  counterOfferAmount   Decimal?              @db.Decimal(12, 2)
  parentComment        String?
  reviewedByUserId     String?
  paypalOrderId        String?               @unique
  paypalCaptureId      String?               @unique
  idempotencyKey       String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child      Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("SpendingReviewedByParent", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([familyId, status])
  @@index([childId, status])
  @@index([paypalOrderId])
}

model SpendingRule {
  id                        String   @id @default(cuid())
  childId                   String   @unique
  maxPerTransaction         Decimal? @db.Decimal(12, 2)
  dailyLimit                Decimal? @db.Decimal(12, 2)
  weeklyLimit               Decimal? @db.Decimal(12, 2)
  monthlyLimit              Decimal? @db.Decimal(12, 2)
  inStoreEnabled            Boolean  @default(true)
  onlineEnabled             Boolean  @default(true)
  ageBlockEnabled           Boolean  @default(true)
  autoApproveUnderAmount    Decimal? @db.Decimal(12, 2)
  autoApproveCategories     String[]
  safeListMerchants         String[]
  requireApprovalCategories String[]
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// A top-up authorizes family spending. It never creates a PayPal payment.
model FamilyTopUp {
  id             String   @id @default(cuid())
  familyId       String
  actorUserId    String
  amount         Decimal  @db.Decimal(12, 2)
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  family         Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

// Separate from historical recipient-email spending requests. Invoice totals
// are generated by the server; clients cannot substitute a price or vault ID.
model Purchase {
  id               String    @id @default(cuid())
  familyId         String
  childId          String
  amount           Decimal   @db.Decimal(12, 2)
  currency         String    @default("USD")
  items            Json
  status           String    @default("CREATED")
  decisionReason   String?
  aiDecision       String?
  reviewedByUserId String?
  payerUserId      String?
  paypalOrderId    String?   @unique
  paypalCaptureId  String?   @unique
  paymentAttempt   Int       @default(0)
  paymentStartedAt DateTime?
  idempotencyKey   String    @unique
  processingAt     DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  family           Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child            Child     @relation(fields: [childId], references: [id], onDelete: Restrict)

  @@index([familyId, status, createdAt])
  @@index([childId, paidAt])
}

model Charity {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  logoUrl     String?
  paypalEmail String
  websiteUrl  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  donations Donation[]
}

model Donation {
  id               String         @id @default(cuid())
  familyId         String
  childId          String
  charityId        String
  amount           Decimal        @db.Decimal(12, 2)
  status           DonationStatus @default(PENDING_APPROVAL)
  receiptNumber    String?        @unique
  paypalOrderId    String?        @unique
  paypalCaptureId  String?        @unique
  reviewedByUserId String?
  createdAt        DateTime       @default(now())
  approvedAt       DateTime?

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  child   Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  charity Charity @relation(fields: [charityId], references: [id], onDelete: Restrict)

  @@index([childId, createdAt])
  @@index([familyId])
}

// ============================================================================
// FINANCIAL EDUCATION & GAMIFICATION
// ============================================================================

model Lesson {
  id                 String      @id @default(cuid())
  title              String
  slug               String      @unique
  topic              LessonTopic
  ageGroup           AgeGroup
  summary            String
  content            Json
  quizQuestions      Json
  xpReward           Int         @default(50)
  defaultMoneyReward Decimal     @default(0.00) @db.Decimal(12, 2)
  badgeCode          String?
  isActive           Boolean     @default(true)
  orderIndex         Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  progress LessonProgress[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  childId     String
  lessonId    String
  score       Int       @default(0)
  completed   Boolean   @default(false)
  rewardPaid  Decimal   @default(0.00) @db.Decimal(12, 2)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([childId, lessonId])
}

model Badge {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  icon        String
  xpBonus     Int      @default(25)
  createdAt   DateTime @default(now())

  childBadges ChildBadge[]
}

model ChildBadge {
  id       String   @id @default(cuid())
  childId  String
  badgeId  String
  earnedAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([childId, badgeId])
}

// ============================================================================
// NOTIFICATIONS, SUPPORT, DISPUTES & ADMIN
// ============================================================================

model Notification {
  id        String              @id @default(cuid())
  familyId  String?
  userId    String?
  childId   String?
  type      String
  title     String
  message   String
  metadata  Json?
  isRead    Boolean             @default(false)
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime            @default(now())

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  child  Child?  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([childId, isRead])
}

model PushSubscription {
  id          String       @id @default(cuid())
  userId      String?
  childId     String?
  platform    PushPlatform @default(WEB_VAPID)
  endpoint    String       @unique
  p256dh      String?
  auth        String?
  deviceToken String?
  deviceName  String?
  userAgent   String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  child Child? @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([userId, platform, isActive])
  @@index([childId, platform, isActive])
}

model UserSecurityQuestion {
  id           String   @id @default(cuid())
  userId       String
  questionKey  String
  questionText String
  answerHash   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
}

// Temporary parent onboarding data used while email, password, and security
// questions are collected across the staged Pudding signup flow.
model ParentSignupDraft {
  id                       String    @id @default(cuid())
  email                    String    @unique
  otpHash                  String?
  otpExpiresAt             DateTime?
  otpAttempts              Int       @default(0)
  emailVerifiedAt          DateTime?
  passwordHash             String?
  securityQuestions        Json?
  notificationsCompletedAt DateTime?
  expiresAt                DateTime
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([expiresAt])
}

model NotificationPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  pushEnabled            Boolean  @default(true)
  emailEnabled           Boolean  @default(true)
  smsEnabled             Boolean  @default(false)
  notifyEveryTransaction Boolean  @default(true)
  notifyThresholdAmount  Decimal? @db.Decimal(12, 2)
  weeklyDigestEnabled    Boolean  @default(true)
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id                String              @id @default(cuid())
  familyId          String
  userId            String
  subject           String
  message           String
  status            SupportTicketStatus @default(OPEN)
  adminResponse     String?
  resolvedByAdminId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([status])
}

model Dispute {
  id                String        @id @default(cuid())
  familyId          String
  parentId          String
  ledgerEntryId     String?
  spendingRequestId String?
  reason            String
  description       String
  amount            Decimal       @db.Decimal(12, 2)
  status            DisputeStatus @default(OPEN)
  resolutionNote    String?
  resolvedByAdminId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([status])
}

model SystemConfig {
  key              String   @id
  value            Json
  description      String?
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  familyId     String?
  actorUserId  String?
  actorChildId String?
  actorRole    String
  action       String
  targetType   String
  targetId     String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  family     Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  actorUser  User?   @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorChild Child?  @relation("ActorChild", fields: [actorChildId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model WebhookEvent {
  id           String               @id @default(cuid())
  eventId      String               @unique
  eventType    String
  payload      Json
  status       WebhookProcessStatus @default(PROCESSED)
  errorMessage String?
  processedAt  DateTime             @default(now())
  createdAt    DateTime             @default(now())

  @@index([eventType])
}

model VerificationToken {
  id         String              @id @default(cuid())
  userId     String
  target     String
  codeHash   String
  purpose    VerificationPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}
