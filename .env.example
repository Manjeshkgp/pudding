# ==============================================================================
# 1. APP & SERVER CONFIGURATION
# ==============================================================================
NODE_ENV="development"

# Local URL of your Next.js app ( runs on port 3000 by default )
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public Base URL used for PayPal OAuth callbacks & Webhooks when testing via ngrok.
# -> When testing PayPal OAuth or Webhooks via ngrok, set this to your https://xxxx.ngrok-free.app URL
# -> Otherwise keep it as http://localhost:3000
APP_BASE_URL="http://localhost:3000"


# ==============================================================================
# 2. DATABASE (LOCAL DOCKER POSTGRESQL -> LATER RENDER POSTGRESQL)
# ==============================================================================
# Example for local Docker Postgres: postgresql://postgres:postgres@localhost:5432/goodspend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodspend"


# ==============================================================================
# 3. AUTHENTICATION, SESSIONS & SECURITY (TASKS 2, 3, 9)
# ==============================================================================
# Secret key used to sign Parent, Child, and Admin HTTP-only JWT session tokens
# (Generate any 32+ char random string, e.g.: openssl rand -base64 32)
JWT_SECRET="replace-with-a-strong-32-character-secret-key-here"

# Access token expiry durations
PARENT_SESSION_EXPIRES_IN="7d"
CHILD_SESSION_EXPIRES_IN="30d"

# Secret token to protect internal scheduled job endpoints (/api/jobs/*) if triggered via HTTP
CRON_SECRET="replace-with-a-random-cron-secret"

# Initial Admin account seed credentials (for Task 9 Admin Console login)
INITIAL_ADMIN_EMAIL="admin@goodspend.app"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"


# ==============================================================================
# 4. PAYPAL SANDBOX / PRODUCTION CONFIGURATION (TASKS 2 & 7)
# ==============================================================================
# Environment mode: "sandbox" or "live"
PAYPAL_ENV="sandbox"

# PayPal REST API Credentials (from developer.paypal.com -> Apps & Credentials)
# Next.js needs NEXT_PUBLIC_PAYPAL_CLIENT_ID for the frontend PayPal Checkout button popup (Way 1)
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"
PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-sandbox-client-secret"

# PayPal API Base URLs (Keep these defaults for Sandbox; switch to api-m.paypal.com & www.paypal.com for Live)
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_AUTH_BASE_URL="https://www.sandbox.paypal.com"

# PayPal OAuth Redirect URI ("Log in with PayPal" in Task 2)
# Must match the Return URL added in your PayPal Developer App settings -> Log in with PayPal
# (Can use http://localhost:3000/api/auth/paypal/callback or your ngrok URL + /api/auth/paypal/callback)
PAYPAL_OAUTH_REDIRECT_URI="http://localhost:3000/api/auth/paypal/callback"

# PayPal Webhook ID (from developer.paypal.com -> Your App -> Webhooks)
# Point your PayPal Sandbox Webhook URL to: https://<your-ngrok-domain>/api/webhooks/paypal
# Copy the resulting "Webhook ID" from PayPal Dashboard and paste it here for signature verification (INT-3)
PAYPAL_WEBHOOK_ID="your-paypal-sandbox-webhook-id"


# ==============================================================================
# 5. FILE UPLOADS - CLOUDINARY (CHORE PROOF PHOTOS & SPEND IMAGES - TASKS 4 & 6)
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="goodspend"
MAX_UPLOAD_FILE_SIZE_MB="5"


# ==============================================================================
# 6. CRON JOBS & SYSTEM DEFAULTS (TASKS 1, 4, 5, 7)
# ==============================================================================
# Set to "true" to run node-cron inside the persistent Node server (local & Render)
ENABLE_IN_PROCESS_CRON="true"

# Default platform currency
DEFAULT_CURRENCY="USD"

# Resend API Key for email verifications and weekly alerts (if/any)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="GoodSpend <noreply@goodspend.manjesh.co.in>"

# Web Push (VAPID) keys for real-time browser push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@goodspend.app"

# Mobile SMS OTP Provider ("mock" by default; pluggable for "twilio" / "msg91" later)
SMS_PROVIDER="mock"
DEMO_DEFAULT_DAILY_LIMIT_USD=20

# Google AI Studio: server-only key; free-tier model, quotas apply
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
